{
  "$id": "magic-basic-land-observation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_player": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "pending_sba_ordering": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "completed_orders": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "ordered_objects": {
                    "items": {
                      "pattern": "^(0|[1-9][0-9]*)$",
                      "type": "string"
                    },
                    "minItems": 2,
                    "type": "array"
                  },
                  "owner": {
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "type": "string"
                  }
                },
                "required": [
                  "owner",
                  "ordered_objects"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "next_order_owner": {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "required": [
            "completed_orders",
            "next_order_owner"
          ],
          "type": "object"
        }
      ]
    },
    "pending_blocks": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "blocker": {
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string"
              },
              "attacker": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "pattern": "^(0|[1-9][0-9]*)$",
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "blocker",
              "attacker"
            ],
            "type": "object"
          },
          "type": "array"
        }
      ]
    },
    "pending_damage_assignment": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "items": {
            "additionalProperties": false,
            "properties": {
              "attacker": {
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string"
              },
              "blocker": {
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string"
              },
              "amount": {
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string"
              }
            },
            "required": [
              "attacker",
              "blocker",
              "amount"
            ],
            "type": "object"
          },
          "type": "array"
        }
      ]
    },
    "priority": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "held_by"
            },
            "player": {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "player"
          ],
          "type": "object"
        }
      ]
    },
    "schema_version": {
      "const": "magic-basic-land-observation.v1"
    },
    "turn_number": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "turn_position": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "beginning"
            },
            "step": {
              "enum": [
                "untap",
                "upkeep",
                "draw"
              ]
            }
          },
          "required": [
            "kind",
            "step"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "precombat_main"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "combat"
            },
            "step": {
              "enum": [
                "beginning_of_combat",
                "declare_attackers",
                "declare_blockers",
                "combat_damage",
                "end_of_combat"
              ]
            }
          },
          "required": [
            "kind",
            "step"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "postcombat_main"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ending"
            },
            "step": {
              "enum": [
                "end_step",
                "cleanup"
              ]
            }
          },
          "required": [
            "kind",
            "step"
          ],
          "type": "object"
        }
      ]
    },
    "mana_pools": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "player": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "unrestricted": {
            "items": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          },
          "creature_spell_only": {
            "items": {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 6,
            "minItems": 6,
            "type": "array"
          }
        },
        "required": [
          "player",
          "unrestricted",
          "creature_spell_only"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "counters": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "counter_kind": {
            "enum": [
              "plus_one_plus_one",
              "minus_one_minus_one",
              "lore"
            ]
          },
          "count": {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "object",
          "counter_kind",
          "count"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "attachments": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "target": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "source",
          "target"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "faces": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "object": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "face": {
            "enum": [
              "front",
              "back"
            ]
          }
        },
        "required": [
          "object",
          "face"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "players": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "player": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "life": {
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": "integer"
          },
          "hand_count": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "library_count": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "player",
          "life",
          "hand_count",
          "library_count"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "tapped": {
      "items": {
        "pattern": "^(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "permanents": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "power": {
                  "type": "null"
                }
              },
              "required": [
                "power"
              ]
            },
            "then": {
              "properties": {
                "toughness": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "toughness": {
                  "type": "null"
                }
              },
              "required": [
                "toughness"
              ]
            },
            "then": {
              "properties": {
                "power": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "power": {
                  "type": "null"
                }
              },
              "required": [
                "power"
              ]
            },
            "then": {
              "properties": {
                "marked_damage": {
                  "const": "0"
                }
              }
            }
          }
        ],
        "properties": {
          "object": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "controller": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "controlled_since_turn": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "power": {
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": [
              "integer",
              "null"
            ]
          },
          "toughness": {
            "maximum": 9223372036854775807,
            "minimum": -9223372036854775808,
            "type": [
              "integer",
              "null"
            ]
          },
          "marked_damage": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "object",
          "controller",
          "controlled_since_turn",
          "power",
          "toughness",
          "marked_damage"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "attacking": {
      "items": {
        "pattern": "^(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "blocked": {
      "items": {
        "pattern": "^(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "blocking": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocker": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "attacker": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "pattern": "^(0|[1-9][0-9]*)$",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "blocker",
          "attacker"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "active_player",
    "turn_number",
    "turn_position",
    "priority",
    "players",
    "pending_sba_ordering",
    "pending_blocks",
    "pending_damage_assignment",
    "mana_pools",
    "counters",
    "attachments",
    "faces",
    "tapped",
    "permanents",
    "attacking",
    "blocked",
    "blocking"
  ],
  "title": "Magic Basic Land Observation V1",
  "type": "object"
}
