{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manafold.m2.5.b2.closure-current-root.v1",
  "title": "B2 Closure Current Root v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "manafold.m2.5.b2.closure-current-root.v1" },
    "artifact_role": { "enum": ["b2_closure", "b2_closure_v2"] },
    "closure_version": { "enum": ["v1", "v2"] },
    "repository_relative_path": { "type": "string", "minLength": 1 },
    "closure_schema_id": { "type": "string", "minLength": 1 },
    "closure_raw_sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "source_package_sha256": {
      "const": "99b33945a3e0c7b2982734e65f770715029ce6acd500104bde48e8466eed1a90"
    }
  },
  "required": [
    "schema",
    "artifact_role",
    "closure_version",
    "repository_relative_path",
    "closure_schema_id",
    "closure_raw_sha256",
    "source_package_sha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "closure_version": { "const": "v1" } },
        "required": ["closure_version"]
      },
      "then": {
        "properties": {
          "artifact_role": { "const": "b2_closure" },
          "repository_relative_path": {
            "const": "sources/m2_5/closures/B2/classification_closure.v1.json"
          },
          "closure_schema_id": {
            "const": "manafold.m2.5.b2.classification-closure.v1"
          },
          "closure_raw_sha256": {
            "const": "ed6a0bf4b0eb83c85027fdcc61eaf32bfa7bb06d4de78c77d0946d87212e7d43"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "closure_version": { "const": "v2" } },
        "required": ["closure_version"]
      },
      "then": {
        "properties": {
          "artifact_role": { "const": "b2_closure_v2" },
          "repository_relative_path": {
            "const": "sources/m2_5/closures/B2/classification_closure.v2.json"
          },
          "closure_schema_id": {
            "const": "manafold.m2.5.b2.classification-closure.v2"
          }
        }
      }
    }
  ]
}
