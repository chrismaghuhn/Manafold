{
  "$id": "authoritative-replay.v6.schema.json",
  "$schema": "https://json-schema.org/draft 2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest": {
            "properties": {
              "semantic_contract": {
                "properties": {
                  "rules_manifest": {
                    "properties": {
                      "rules_authority": {
                        "properties": {"variant": {"const": "comprehensive_rules"}},
                        "required": ["variant"]
                      },
                      "capability_closure": {
                        "type": "array",
                        "contains": {
                          "type": "object",
                          "properties": {
                            "key": {"const": "rules/state-based-actions-combat"},
                            "version": {"const": "0.1.0"}
                          },
                          "required": ["key", "version"]
                        }
                      }
                    },
                    "required": ["rules_authority", "capability_closure"]
                  }
                },
                "required": ["rules_manifest"]
              }
            },
            "required": ["semantic_contract"]
          }
        },
        "required": ["manifest"]
      },
      "then": {
        "if": {
          "properties": {
            "manifest": {
              "properties": {
                "semantic_contract": {
                  "properties": {
                    "rules_manifest": {
                      "properties": {
                        "capability_closure": {
                          "contains": {
                            "properties": {"key": {"const": "rules/combat-phase"}},
                            "required": ["key"]
                          }
                        }
                      },
                      "required": ["capability_closure"]
                    }
                  },
                  "required": ["rules_manifest"]
                }
              },
              "required": ["semantic_contract"]
            }
          },
          "required": ["manifest"]
        },
        "then": {
          "if": {
            "properties": {
              "manifest": {
                "properties": {
                  "semantic_contract": {
                    "properties": {
                      "rules_manifest": {
                        "properties": {
                          "capability_closure": {"const": [
                            {"key": "rules/basic-priority", "version": "0.1.0"},
                            {"key": "rules/combat-phase", "version": "0.1.0"},
                            {"key": "rules/declare-attackers", "version": "0.1.0"},
                            {"key": "rules/declare-blockers", "version": "0.1.0"},
                            {"key": "rules/draw-card", "version": "0.1.0"},
                            {"key": "rules/state-based-actions-combat", "version": "0.1.0"},
                            {"key": "rules/turn-structure", "version": "0.1.0"},
                            {"key": "rules/zone-incarnation", "version": "0.1.0"}
                          ]}
                        },
                        "required": ["capability_closure"]
                      }
                    },
                    "required": ["rules_manifest"]
                  }
              }
            }
          },
            "required": ["manifest"]
          },
          "then": {
            "properties": {
              "manifest": {
                "properties": {
                  "schemas": {
                    "properties": {
                      "observation_payload_codec": {"const": "magic-combat-observation.v3"}
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "manifest": {
                "properties": {
                  "schemas": {
                    "properties": {
                      "observation_payload_codec": {"const": "magic-combat-observation.v2"}
                    }
                  }
                }
              }
            }
          }
        },
        "else": {
          "properties": {
            "manifest": {
              "properties": {
                "schemas": {
                  "properties": {
                    "observation_payload_codec": {"const": "magic-m3-observation.v1"}
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "manifest": {
            "properties": {
              "schemas": {
                "properties": {
                  "observation_payload_codec": {"const": "synthetic-m3-observation.v1"}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uint": {"pattern": "^(0|[1-9][0-9]*)$", "type": "string"},
    "digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "contract_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "contract_id_nullable": {"anyOf": [{"$ref": "#/$defs/contract_id"}, {"type": "null"}]},
    "u32": {"maximum": 4294967295, "minimum": 0, "type": "integer"},
    "i64": {"maximum": 9223372036854775807, "minimum": -9223372036854775808, "type": "integer"},
    "u64": {"maximum": 18446744073709551615, "minimum": 0, "type": "integer"},
    "counters": {"additionalProperties": false, "properties": {"accepted_transitions": {"$ref": "#/$defs/u64"}, "decisions_submitted": {"$ref": "#/$defs/u64"}, "resource_units_consumed": {"$ref": "#/$defs/u64"}, "rule_events_emitted": {"$ref": "#/$defs/u64"}, "wall_clock_elapsed_millis": {"$ref": "#/$defs/u64"}}, "required": ["decisions_submitted", "accepted_transitions", "rule_events_emitted", "resource_units_consumed", "wall_clock_elapsed_millis"], "type": "object"},
    "outcome": {"additionalProperties": false, "properties": {"player": {"$ref": "#/$defs/uint"}, "result": {"enum": ["win", "loss", "draw", "eliminated", "unresolved"]}}, "required": ["player", "result"], "type": "object"},
    "status": {"oneOf": [{"additionalProperties": false, "properties": {"kind": {"const": "running"}}, "required": ["kind"], "type": "object"}, {"additionalProperties": false, "properties": {"kind": {"const": "terminal"}, "players": {"items": {"$ref": "#/$defs/outcome"}, "type": "array"}, "reason": {"enum": ["rules_loss", "concession", "simultaneous_outcome", "rules_draw", "specified_loop"]}}, "required": ["kind", "reason", "players"], "type": "object"}, {"additionalProperties": false, "properties": {"kind": {"const": "truncated"}, "players": {"items": {"$ref": "#/$defs/outcome"}, "type": "array"}, "reason": {"enum": ["decision_limit", "rule_event_limit", "wall_clock_limit", "resource_limit", "external_stop"]}}, "required": ["kind", "reason", "players"], "type": "object"}]},
    "codec_identity": {"additionalProperties": false, "properties": {"codec_id": {"const": "in-memory-reference"}, "semantic_version": {"const": "6"}}, "required": ["codec_id", "semantic_version"], "type": "object"},
    "rules_authority": {"anyOf": [{"additionalProperties": false, "properties": {"variant": {"const": "synthetic_legacy"}}, "required": ["variant"], "type": "object"}, {"additionalProperties": false, "properties": {"snapshot_id": {"minLength": 1, "type": "string"}, "variant": {"const": "comprehensive_rules"}}, "required": ["variant", "snapshot_id"], "type": "object"}]},
    "capability_requirement": {"additionalProperties": false, "properties": {"key": {"pattern": "^(rules|mechanic|decision|visibility|tooling|format/[a-z0-9-]+)/[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$", "type": "string"}, "version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"}}, "required": ["key", "version"], "type": "object"},
    "rules_contract_manifest": {"additionalProperties": false, "properties": {"capability_closure": {"items": {"$ref": "#/$defs/capability_requirement"}, "type": ["array", "null"]}, "rules_authority": {"$ref": "#/$defs/rules_authority"}}, "required": ["rules_authority", "capability_closure"], "type": "object"},
    "semantic_contract_manifest": {"additionalProperties": false, "properties": {"content_contract_id": {"$ref": "#/$defs/contract_id_nullable"}, "format_contract_id": {"$ref": "#/$defs/contract_id_nullable"}, "rules_contract_id": {"$ref": "#/$defs/contract_id"}}, "required": ["rules_contract_id", "format_contract_id", "content_contract_id"], "type": "object"},
    "semantic_contract_material": {"additionalProperties": false, "properties": {"manifest": {"$ref": "#/$defs/semantic_contract_manifest"}, "rules_manifest": {"$ref": "#/$defs/rules_contract_manifest"}, "semantic_contract_id": {"$ref": "#/$defs/contract_id"}}, "required": ["semantic_contract_id", "manifest", "rules_manifest"], "type": "object"},
    "execution_identity": {"additionalProperties": false, "properties": {"program_kind": {"enum": ["synthetic_rules_compat", "magic_rules"]}, "semantic_contract_id": {"$ref": "#/$defs/contract_id"}}, "required": ["program_kind", "semantic_contract_id"], "type": "object"},
    "identity": {"additionalProperties": false, "properties": {"checkpoint_codec_identity": {"$ref": "#/$defs/codec_identity"}, "checkpoint_digest": {"$ref": "#/$defs/digest"}, "environment_limit_counters": {"$ref": "#/$defs/counters"}, "episode_status": {"$ref": "#/$defs/status"}, "execution_identity": {"$ref": "#/$defs/execution_identity"}, "full_state_digest": {"$ref": "#/$defs/digest"}, "state_revision": {"$ref": "#/$defs/uint"}}, "required": ["state_revision", "full_state_digest", "episode_status", "environment_limit_counters", "checkpoint_codec_identity", "checkpoint_digest", "execution_identity"], "type": "object"},
    "schemas": {"additionalProperties": false, "properties": {"decision": {"const": "player-decision-request.v2"}, "decision_response": {"const": "decision-response.v2"}, "information_state": {"const": "information-state-envelope.v2"}, "observation": {"const": "observation-envelope.v1"}, "observation_payload_codec": {"enum": ["synthetic-m3-observation.v1", "magic-m3-observation.v1", "magic-combat-observation.v2", "magic-combat-observation.v3"]}, "observed_event": {"const": "observed-event-envelope.v2"}, "player_step": {"const": "player-step.v2"}, "replay_step": {"const": "replay-step.v6"}}, "required": ["observation", "observation_payload_codec", "information_state", "decision", "decision_response", "observed_event", "player_step", "replay_step"], "type": "object"},
    "kernel": {"additionalProperties": false, "properties": {"build_profile": {"minLength": 1, "type": "string"}, "implementation_id": {"minLength": 1, "type": "string"}, "semantic_version": {"minLength": 1, "type": "string"}}, "required": ["implementation_id", "semantic_version", "build_profile"], "type": "object"},
    "randomness": {"additionalProperties": false, "properties": {"contract_id": {"const": "mtgml.rng.v1"}, "root_seed_hex": {"$ref": "#/$defs/digest"}}, "required": ["contract_id", "root_seed_hex"], "type": "object"},
    "deck": {"additionalProperties": false, "properties": {"deck_id": {"minLength": 1, "type": "string"}, "digest": {"$ref": "#/$defs/digest"}, "player": {"$ref": "#/$defs/uint"}}, "required": ["player", "deck_id", "digest"], "type": "object"},
    "answer": {"oneOf": [{"additionalProperties": false, "properties": {"candidate_id": {"$ref": "#/$defs/u32"}, "kind": {"const": "select_one"}}, "required": ["kind", "candidate_id"], "type": "object"}, {"additionalProperties": false, "properties": {"candidate_ids": {"items": {"$ref": "#/$defs/u32"}, "type": "array"}, "kind": {"const": "select_many"}}, "required": ["kind", "candidate_ids"], "type": "object"}, {"additionalProperties": false, "properties": {"kind": {"const": "choose_number"}, "value": {"$ref": "#/$defs/i64"}}, "required": ["kind", "value"], "type": "object"}, {"additionalProperties": false, "properties": {"candidate_ids": {"items": {"$ref": "#/$defs/u32"}, "type": "array"}, "kind": {"const": "order"}}, "required": ["kind", "candidate_ids"], "type": "object"}]},
    "response": {"additionalProperties": false, "properties": {"answer": {"$ref": "#/$defs/answer"}, "player_decision_id": {"$ref": "#/$defs/uint"}, "schema_version": {"const": "decision-response.v2"}, "state_revision": {"$ref": "#/$defs/uint"}}, "required": ["schema_version", "player_decision_id", "state_revision", "answer"], "type": "object"},
    "step": {"additionalProperties": false, "properties": {"accepted": {"type": "boolean"}, "actor": {"$ref": "#/$defs/uint"}, "checkpoint_digest_after": {"$ref": "#/$defs/digest"}, "checkpoint_digest_before": {"$ref": "#/$defs/digest"}, "environment_limit_counters_after": {"$ref": "#/$defs/counters"}, "episode_status_after": {"$ref": "#/$defs/status"}, "full_state_digest_after": {"$ref": "#/$defs/digest"}, "response": {"$ref": "#/$defs/response"}, "state_revision_after": {"$ref": "#/$defs/uint"}, "state_revision_before": {"$ref": "#/$defs/uint"}, "step_index": {"$ref": "#/$defs/u64"}}, "required": ["step_index", "actor", "checkpoint_digest_before", "state_revision_before", "response", "accepted", "state_revision_after", "full_state_digest_after", "episode_status_after", "environment_limit_counters_after", "checkpoint_digest_after"], "type": "object"},
    "manifest": {"additionalProperties": false, "properties": {"card_bundle": {"minLength": 1, "type": "string"}, "decks": {"items": {"$ref": "#/$defs/deck"}, "minItems": 1, "type": "array"}, "engine_build": {"minLength": 1, "type": "string"}, "execution_identity": {"$ref": "#/$defs/execution_identity"}, "format_policy_snapshot": {"minLength": 1, "type": "string"}, "initial_identity": {"$ref": "#/$defs/identity"}, "kernel": {"$ref": "#/$defs/kernel"}, "oracle_snapshot": {"minLength": 1, "type": "string"}, "randomness": {"$ref": "#/$defs/randomness"}, "rules_snapshot": {"minLength": 1, "type": "string"}, "schema_version": {"const": "replay-manifest.v6"}, "schemas": {"$ref": "#/$defs/schemas"}, "semantic_contract": {"$ref": "#/$defs/semantic_contract_material"}}, "required": ["schema_version", "engine_build", "kernel", "rules_snapshot", "format_policy_snapshot", "oracle_snapshot", "card_bundle", "schemas", "randomness", "decks", "initial_identity", "execution_identity", "semantic_contract"], "type": "object"}
  },
  "properties": {
    "final_identity": {"$ref": "#/$defs/identity"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "schema_version": {"const": "authoritative-replay.v6"},
    "steps": {"items": {"$ref": "#/$defs/step"}, "type": "array"}
  },
  "required": ["schema_version", "manifest", "steps", "final_identity"],
  "title": "AuthoritativeReplay V6",
  "type": "object"
}
