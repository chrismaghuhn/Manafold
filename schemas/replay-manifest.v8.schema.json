{
  "$defs": {
    "capability_requirement": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^(rules|mechanic|decision|visibility|tooling|format/[a-z0-9-]+)/[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "key",
        "version"
      ],
      "type": "object"
    },
    "codec_identity": {
      "additionalProperties": false,
      "properties": {
        "codec_id": {
          "const": "in-memory-reference"
        },
        "semantic_version": {
          "const": "8"
        }
      },
      "required": [
        "codec_id",
        "semantic_version"
      ],
      "type": "object"
    },
    "contract_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "contract_id_nullable": {
      "anyOf": [
        {
          "$ref": "#/$defs/contract_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "counters": {
      "additionalProperties": false,
      "properties": {
        "accepted_transitions": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "decisions_submitted": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "resource_units_consumed": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "rule_events_emitted": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "wall_clock_elapsed_millis": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "decisions_submitted",
        "accepted_transitions",
        "rule_events_emitted",
        "resource_units_consumed",
        "wall_clock_elapsed_millis"
      ],
      "type": "object"
    },
    "deck": {
      "additionalProperties": false,
      "properties": {
        "deck_id": {
          "minLength": 1,
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "player": {
          "$ref": "#/$defs/uint"
        }
      },
      "required": [
        "player",
        "deck_id",
        "digest"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_identity": {
      "additionalProperties": false,
      "properties": {
        "program_kind": {
          "enum": [
            "magic_rules"
          ]
        },
        "semantic_contract_id": {
          "$ref": "#/$defs/contract_id"
        }
      },
      "required": [
        "program_kind",
        "semantic_contract_id"
      ],
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_codec_identity": {
          "$ref": "#/$defs/codec_identity"
        },
        "checkpoint_digest": {
          "$ref": "#/$defs/digest"
        },
        "environment_limit_counters": {
          "$ref": "#/$defs/counters"
        },
        "episode_status": {
          "$ref": "#/$defs/status"
        },
        "execution_identity": {
          "$ref": "#/$defs/execution_identity"
        },
        "full_state_digest": {
          "$ref": "#/$defs/digest"
        },
        "state_revision": {
          "$ref": "#/$defs/uint"
        }
      },
      "required": [
        "state_revision",
        "full_state_digest",
        "episode_status",
        "environment_limit_counters",
        "checkpoint_codec_identity",
        "checkpoint_digest",
        "execution_identity"
      ],
      "type": "object"
    },
    "kernel": {
      "additionalProperties": false,
      "properties": {
        "build_profile": {
          "minLength": 1,
          "type": "string"
        },
        "implementation_id": {
          "minLength": 1,
          "type": "string"
        },
        "semantic_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "implementation_id",
        "semantic_version",
        "build_profile"
      ],
      "type": "object"
    },
    "randomness": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "const": "mtgml.rng.v1"
        },
        "root_seed_hex": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "contract_id",
        "root_seed_hex"
      ],
      "type": "object"
    },
    "rules_authority": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "snapshot_id": {
              "minLength": 1,
              "type": "string"
            },
            "variant": {
              "const": "comprehensive_rules"
            }
          },
          "required": [
            "variant",
            "snapshot_id"
          ],
          "type": "object"
        }
      ]
    },
    "rules_contract_manifest": {
      "additionalProperties": false,
      "properties": {
        "capability_closure": {
          "items": {
            "$ref": "#/$defs/capability_requirement"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "rules_authority": {
          "$ref": "#/$defs/rules_authority"
        }
      },
      "required": [
        "rules_authority",
        "capability_closure"
      ],
      "type": "object"
    },
    "schemas": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "const": "player-decision-request.v4"
        },
        "decision_response": {
          "const": "decision-response.v3"
        },
        "information_state": {
          "const": "information-state-envelope.v3"
        },
        "observation": {
          "const": "observation-envelope.v2"
        },
        "observation_payload_codec": {
          "const": "magic-shared-execution-observation.v1"
        },
        "observed_event": {
          "const": "observed-event-envelope.v4"
        },
        "player_step": {
          "const": "player-step.v4"
        },
        "replay_step": {
          "const": "replay-step.v8"
        }
      },
      "required": [
        "observation",
        "observation_payload_codec",
        "information_state",
        "decision",
        "decision_response",
        "observed_event",
        "player_step",
        "replay_step"
      ],
      "type": "object"
    },
    "semantic_contract_manifest": {
      "additionalProperties": false,
      "properties": {
        "content_contract_id": {
          "$ref": "#/$defs/contract_id_nullable"
        },
        "format_contract_id": {
          "$ref": "#/$defs/contract_id_nullable"
        },
        "rules_contract_id": {
          "$ref": "#/$defs/contract_id"
        }
      },
      "required": [
        "rules_contract_id",
        "format_contract_id",
        "content_contract_id"
      ],
      "type": "object"
    },
    "semantic_contract_material": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "content_contract": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "manifest": {
                "properties": {
                  "content_contract_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "content_contract_id"
                ]
              }
            },
            "required": [
              "manifest"
            ]
          },
          "then": {
            "properties": {
              "content_contract": {
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "content_contract": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "content_contract_id": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "manifest_canonical_cbor_base64": {
                  "maxLength": 89478488,
                  "minLength": 4,
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                  "type": "string"
                }
              },
              "required": [
                "content_contract_id",
                "manifest_canonical_cbor_base64"
              ],
              "type": "object"
            }
          ]
        },
        "manifest": {
          "$ref": "#/$defs/semantic_contract_manifest"
        },
        "rules_manifest": {
          "$ref": "#/$defs/rules_contract_manifest"
        },
        "semantic_contract_id": {
          "$ref": "#/$defs/contract_id"
        }
      },
      "required": [
        "semantic_contract_id",
        "manifest",
        "rules_manifest",
        "content_contract"
      ],
      "type": "object"
    },
    "status": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "running"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "terminal"
            },
            "players": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "player": {
                    "$ref": "#/$defs/uint"
                  },
                  "result": {
                    "enum": [
                      "win",
                      "loss",
                      "draw",
                      "eliminated",
                      "unresolved"
                    ]
                  }
                },
                "required": [
                  "player",
                  "result"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "reason": {
              "enum": [
                "rules_loss",
                "concession",
                "simultaneous_outcome",
                "rules_draw",
                "specified_loop"
              ]
            }
          },
          "required": [
            "kind",
            "reason",
            "players"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "truncated"
            },
            "players": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "player": {
                    "$ref": "#/$defs/uint"
                  },
                  "result": {
                    "enum": [
                      "win",
                      "loss",
                      "draw",
                      "eliminated",
                      "unresolved"
                    ]
                  }
                },
                "required": [
                  "player",
                  "result"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "reason": {
              "enum": [
                "decision_limit",
                "rule_event_limit",
                "wall_clock_limit",
                "resource_limit",
                "external_stop"
              ]
            }
          },
          "required": [
            "kind",
            "reason",
            "players"
          ],
          "type": "object"
        }
      ]
    },
    "uint": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "$id": "replay-manifest.v8.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_identity": {
            "properties": {
              "program_kind": {
                "const": "magic_rules"
              }
            },
            "required": [
              "program_kind"
            ]
          }
        },
        "required": [
          "execution_identity"
        ]
      },
      "then": {
        "properties": {
          "semantic_contract": {
            "properties": {
              "rules_manifest": {
                "properties": {
                  "rules_authority": {
                    "properties": {
                      "variant": {
                        "const": "comprehensive_rules"
                      }
                    },
                    "required": [
                      "variant"
                    ]
                  }
                },
                "required": [
                  "rules_authority"
                ]
              }
            },
            "required": [
              "rules_manifest"
            ]
          }
        },
        "required": [
          "semantic_contract"
        ]
      }
    }
  ],
  "properties": {
    "card_bundle": {
      "minLength": 1,
      "type": "string"
    },
    "decks": {
      "items": {
        "$ref": "#/$defs/deck"
      },
      "minItems": 1,
      "type": "array"
    },
    "engine_build": {
      "minLength": 1,
      "type": "string"
    },
    "execution_identity": {
      "$ref": "#/$defs/execution_identity"
    },
    "format_policy_snapshot": {
      "minLength": 1,
      "type": "string"
    },
    "initial_identity": {
      "$ref": "#/$defs/identity"
    },
    "kernel": {
      "$ref": "#/$defs/kernel"
    },
    "oracle_snapshot": {
      "minLength": 1,
      "type": "string"
    },
    "randomness": {
      "$ref": "#/$defs/randomness"
    },
    "rules_snapshot": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "replay-manifest.v8"
    },
    "schemas": {
      "$ref": "#/$defs/schemas"
    },
    "semantic_contract": {
      "$ref": "#/$defs/semantic_contract_material"
    }
  },
  "required": [
    "schema_version",
    "engine_build",
    "kernel",
    "rules_snapshot",
    "format_policy_snapshot",
    "oracle_snapshot",
    "card_bundle",
    "schemas",
    "randomness",
    "decks",
    "initial_identity",
    "execution_identity",
    "semantic_contract"
  ],
  "title": "ReplayManifest V8",
  "type": "object"
}
