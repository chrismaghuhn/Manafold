{
    "$id": "replay-manifest.v2.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "card_bundle": {
            "minLength": 1,
            "type": "string"
        },
        "decks": {
            "items": {
                "additionalProperties": false,
                "properties": {
                    "deck_id": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "digest": {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                    },
                    "player": {
                        "pattern": "^(0|[1-9][0-9]*)$",
                        "type": "string"
                    }
                },
                "required": [
                    "player",
                    "deck_id",
                    "digest"
                ],
                "type": "object"
            },
            "minItems": 1,
            "type": "array"
        },
        "engine_build": {
            "minLength": 1,
            "type": "string"
        },
        "format_policy_snapshot": {
            "minLength": 1,
            "type": "string"
        },
        "initial_state_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
        },
        "initial_state_revision": {
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
        },
        "kernel": {
            "additionalProperties": false,
            "properties": {
                "build_profile": {
                    "minLength": 1,
                    "type": "string"
                },
                "implementation_id": {
                    "minLength": 1,
                    "type": "string"
                },
                "semantic_version": {
                    "minLength": 1,
                    "type": "string"
                }
            },
            "required": [
                "implementation_id",
                "semantic_version",
                "build_profile"
            ],
            "type": "object"
        },
        "oracle_snapshot": {
            "minLength": 1,
            "type": "string"
        },
        "randomness": {
            "additionalProperties": false,
            "properties": {
                "contract_id": {
                    "const": "mtgml.rng.v1",
                    "type": "string"
                },
                "root_seed_hex": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                }
            },
            "required": [
                "contract_id",
                "root_seed_hex"
            ],
            "type": "object"
        },
        "rules_snapshot": {
            "minLength": 1,
            "type": "string"
        },
        "schema_version": {
            "const": "replay-manifest.v2",
            "type": "string"
        },
        "schemas": {
            "additionalProperties": false,
            "properties": {
                "decision": {
                    "minLength": 1,
                    "type": "string"
                },
                "decision_response": {
                    "minLength": 1,
                    "type": "string"
                },
                "information_state": {
                    "minLength": 1,
                    "type": "string"
                },
                "observation": {
                    "minLength": 1,
                    "type": "string"
                },
                "observed_event": {
                    "minLength": 1,
                    "type": "string"
                },
                "player_step": {
                    "minLength": 1,
                    "type": "string"
                },
                "replay_step": {
                    "const": "replay-step.v2",
                    "type": "string"
                },
                "step_index": {
                    "maximum": 18446744073709551615,
                    "minimum": 0,
                    "type": "integer"
                }
            },
            "required": [
                "observation",
                "information_state",
                "decision",
                "decision_response",
                "observed_event",
                "player_step",
                "replay_step"
            ],
            "type": "object"
        }
    },
    "required": [
        "schema_version",
        "engine_build",
        "kernel",
        "rules_snapshot",
        "format_policy_snapshot",
        "oracle_snapshot",
        "card_bundle",
        "schemas",
        "randomness",
        "decks",
        "initial_state_revision",
        "initial_state_digest"
    ],
    "type": "object"
}
