{
  "$id": "https://example.invalid/schemas/m2-5-exact-two-deck-scope-lock.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "manafold.m2.5.exact-two-deck-scope-lock.v1" },
    "task_id": { "const": "M2_5_EXACT_TWO_DECK_SCOPE_LOCK_01" },
    "lock_status": { "const": "LOCKED" },
    "deck_count": { "const": 2 },
    "deck_pair_locked": { "const": true },
    "pair_selection_basis": { "const": "EXPLICIT_MAINTAINER_SCOPE_DECISION" },
    "authoritative_ranking_available": { "const": false },
    "broad_rev3_scope_reinterpreted": { "const": false },
    "c_pass": { "const": "BLOCKED" },
    "m2_5_final": { "const": "NOT_YET" },
    "m3": { "const": "NOT_AUTHORIZED" },
    "production_authority_created": { "const": false },
    "domain_audit_55_55": { "const": "NOT_RUN" },
    "ranking": { "const": "NOT_RUN" },
    "sideboards": {
      "const": [],
      "type": "array"
    },
    "source_package": { "$ref": "#/$defs/sourcePackage" },
    "snapshot_identities": { "$ref": "#/$defs/snapshotIdentities" },
    "source_bindings": { "$ref": "#/$defs/sourceBindings" },
    "legality_verification": { "$ref": "#/$defs/legalityVerification" },
    "decks": {
      "items": { "$ref": "#/$defs/deck" },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "task_id",
    "lock_status",
    "deck_count",
    "deck_pair_locked",
    "pair_selection_basis",
    "authoritative_ranking_available",
    "broad_rev3_scope_reinterpreted",
    "c_pass",
    "m2_5_final",
    "m3",
    "production_authority_created",
    "domain_audit_55_55",
    "ranking",
    "sideboards",
    "source_package",
    "snapshot_identities",
    "source_bindings",
    "legality_verification",
    "decks"
  ],
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "sourcePackage": {
      "additionalProperties": false,
      "properties": {
        "logical_locator": { "type": "string" },
        "archive_path": { "type": "string" },
        "manifest_member": { "const": "Manafold_M2_5_Package_Manifest_REV3.json" },
        "manifest_member_sha256": { "$ref": "#/$defs/digest" },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "required": [
        "logical_locator",
        "archive_path",
        "manifest_member",
        "manifest_member_sha256",
        "sha256"
      ],
      "type": "object"
    },
    "member": {
      "additionalProperties": false,
      "properties": {
        "authority_id": { "type": "string" },
        "archive_member": { "type": "string" },
        "bytes": { "minimum": 0, "type": "integer" },
        "sha256": { "$ref": "#/$defs/digest" },
        "source_url": { "type": "string" }
      },
      "required": ["archive_member", "bytes", "sha256"],
      "type": "object"
    },
    "snapshotIdentities": {
      "additionalProperties": false,
      "properties": {
        "rules": { "$ref": "#/$defs/member" },
        "format_policy": { "$ref": "#/$defs/member" },
        "legality": { "$ref": "#/$defs/member" },
        "oracle": { "$ref": "#/$defs/member" },
        "rulings": {
          "items": { "$ref": "#/$defs/member" },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": ["rules", "format_policy", "legality", "oracle", "rulings"],
      "type": "object"
    },
    "sourceBindings": {
      "additionalProperties": false,
      "properties": {
        "deck_row_source_resolution": { "$ref": "#/$defs/member" },
        "oracle_source_records": { "$ref": "#/$defs/member" },
        "source_record_index": { "$ref": "#/$defs/member" }
      },
      "required": [
        "deck_row_source_resolution",
        "oracle_source_records",
        "source_record_index"
      ],
      "type": "object"
    },
    "legalityVerification": {
      "additionalProperties": false,
      "properties": {
        "status": { "const": "PASS" },
        "policy": { "const": "official Commander 1v1" },
        "players": { "const": 2 },
        "deck_size": { "const": 100 },
        "deck_construction": { "type": "string" },
        "banlist_exact_name_matches": { "const": [] },
        "commander_color_identity_checks": { "const": "PASS" },
        "oracle_commander_legality_checks": { "const": "PASS" }
      },
      "required": [
        "status",
        "policy",
        "players",
        "deck_size",
        "deck_construction",
        "banlist_exact_name_matches",
        "commander_color_identity_checks",
        "oracle_commander_legality_checks"
      ],
      "type": "object"
    },
    "commander": {
      "additionalProperties": false,
      "properties": {
        "card_name": { "type": "string" },
        "color_identity": {
          "items": { "enum": ["W", "U", "B", "R", "G"] },
          "uniqueItems": true,
          "type": "array"
        },
        "oracle_is_legendary": { "const": true },
        "oracle_semantic_identity": { "type": "string" },
        "oracle_source_record_id": { "type": "string" },
        "source_row_id": { "type": "string" }
      },
      "required": [
        "card_name",
        "color_identity",
        "oracle_is_legendary",
        "oracle_semantic_identity",
        "oracle_source_record_id",
        "source_row_id"
      ],
      "type": "object"
    },
    "card": {
      "additionalProperties": false,
      "properties": {
        "card_name": { "type": "string" },
        "is_basic_land": { "type": "boolean" },
        "is_commander": { "type": "boolean" },
        "oracle_color_identity": {
          "items": { "enum": ["W", "U", "B", "R", "G"] },
          "uniqueItems": true,
          "type": "array"
        },
        "oracle_commander_legality": { "type": "string" },
        "oracle_is_legendary": { "type": "boolean" },
        "oracle_normalized_record_sha256": { "$ref": "#/$defs/digest" },
        "oracle_semantic_identity": { "type": "string" },
        "oracle_source_full_length": { "minimum": 1, "type": "integer" },
        "oracle_source_full_offset": { "minimum": 0, "type": "integer" },
        "oracle_source_record_id": { "type": "string" },
        "oracle_source_record_raw_sha256": { "$ref": "#/$defs/digest" },
        "quantity": { "minimum": 1, "type": "integer" },
        "source_line_number": { "minimum": 1, "type": "integer" },
        "source_line_text": { "type": "string" },
        "source_row_id": { "type": "string" },
        "source_snapshot_file": { "type": "string" }
      },
      "required": [
        "card_name",
        "is_basic_land",
        "is_commander",
        "oracle_color_identity",
        "oracle_commander_legality",
        "oracle_is_legendary",
        "oracle_normalized_record_sha256",
        "oracle_semantic_identity",
        "oracle_source_full_length",
        "oracle_source_full_offset",
        "oracle_source_record_id",
        "oracle_source_record_raw_sha256",
        "quantity",
        "source_line_number",
        "source_line_text",
        "source_row_id",
        "source_snapshot_file"
      ],
      "type": "object"
    },
    "deck": {
      "additionalProperties": false,
      "properties": {
        "card_count": { "const": 100 },
        "cards": {
          "items": { "$ref": "#/$defs/card" },
          "minItems": 1,
          "type": "array"
        },
        "commander": { "$ref": "#/$defs/commander" },
        "content_sha256": { "$ref": "#/$defs/digest" },
        "deck_id": { "pattern": "^m2-5/[a-z0-9-]+$", "type": "string" },
        "deck_name": { "type": "string" },
        "oracle_source_identities": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "normalized_record_sha256": { "$ref": "#/$defs/digest" },
              "oracle_semantic_identity": { "type": "string" },
              "source_record_id": { "type": "string" },
              "source_record_raw_sha256": { "$ref": "#/$defs/digest" }
            },
            "required": [
              "normalized_record_sha256",
              "oracle_semantic_identity",
              "source_record_id",
              "source_record_raw_sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "player": { "enum": [1, 2], "type": "integer" },
        "sideboard": { "const": [], "type": "array" },
        "source_snapshot": {
          "additionalProperties": false,
          "properties": {
            "archive_member": { "type": "string" },
            "bytes": { "minimum": 1, "type": "integer" },
            "sha256": { "$ref": "#/$defs/digest" },
            "source_date": { "const": "2022-12-02" },
            "source_url": { "const": "https://magic.wizards.com/en/news/announcements/starter-commander-decks-decklists-2022-10-20" }
          },
          "required": ["archive_member", "bytes", "sha256", "source_date", "source_url"],
          "type": "object"
        }
      },
      "required": [
        "card_count",
        "cards",
        "commander",
        "content_sha256",
        "deck_id",
        "deck_name",
        "oracle_source_identities",
        "player",
        "sideboard",
        "source_snapshot"
      ],
      "type": "object"
    }
  },
  "title": "M2.5 Exact Two-Deck V1 Scope Lock v1",
  "type": "object"
}
