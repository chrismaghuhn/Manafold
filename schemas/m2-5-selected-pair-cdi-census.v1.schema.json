{
  "$id": "https://example.invalid/schemas/m2-5-selected-pair-cdi-census.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "manafold.m2.5.selected-pair-cdi-census.v1" },
    "artifact_kind": {
      "enum": [
        "capability",
        "decision",
        "information",
        "generated_object",
        "recursive_capability_closure"
      ]
    },
    "task_id": { "const": "M2_5_SELECTED_PAIR_CDI_CENSUS_01" },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "selected_pair": { "$ref": "#/$defs/selectedPair" },
    "source_package_sha256": { "$ref": "#/$defs/digest" },
    "evidence_bindings": { "$ref": "#/$defs/evidenceBindings" },
    "preserved_artifact_digests": { "$ref": "#/$defs/preservedArtifacts" },
    "selected_decks": {
      "items": { "$ref": "#/$defs/deck" },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "record_counts": {
      "additionalProperties": { "minimum": 0, "type": "integer" },
      "type": "object"
    },
    "records": { "items": { "type": "object" }, "type": "array" },
    "families": { "items": { "type": "object" }, "type": "array" },
    "dependency_edges": { "items": { "type": "object" }, "type": "array" },
    "direct_roots": { "items": { "type": "string" }, "type": "array" },
    "resolved_families": { "items": { "type": "string" }, "type": "array" },
    "unresolved_scope_obligations": {
      "items": { "$ref": "#/$defs/unresolved" },
      "type": "array"
    },
    "high_risk_outliers": { "items": { "type": "object" }, "type": "array" },
    "content_sha256": { "$ref": "#/$defs/digest" }
  },
  "required": [
    "schema",
    "artifact_kind",
    "task_id",
    "status",
    "selected_pair",
    "source_package_sha256",
    "evidence_bindings",
    "preserved_artifact_digests",
    "selected_decks",
    "record_counts",
    "records",
    "unresolved_scope_obligations",
    "high_risk_outliers",
    "content_sha256"
  ],
  "$defs": {
    "digest": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "schema": { "type": ["string", "null"] },
        "raw_sha256": { "$ref": "#/$defs/digest" }
      },
      "required": ["path", "schema", "raw_sha256"],
      "type": "object"
    },
    "evidenceBindings": {
      "additionalProperties": false,
      "properties": {
        "b1": { "items": { "$ref": "#/$defs/binding" }, "type": "array" },
        "b2": { "items": { "$ref": "#/$defs/binding" }, "type": "array" },
        "rev3": { "items": { "$ref": "#/$defs/binding" }, "type": "array" }
      },
      "required": ["b1", "b2", "rev3"],
      "type": "object"
    },
    "preservedArtifacts": {
      "additionalProperties": false,
      "properties": {
        "authority": { "items": { "$ref": "#/$defs/binding" }, "type": "array" },
        "b1": { "items": { "$ref": "#/$defs/binding" }, "type": "array" },
        "b2": { "items": { "$ref": "#/$defs/binding" }, "type": "array" },
        "c": { "items": { "$ref": "#/$defs/binding" }, "type": "array" },
        "ranking": { "items": { "$ref": "#/$defs/binding" }, "type": "array" }
      },
      "required": ["authority", "b1", "b2", "c", "ranking"],
      "type": "object"
    },
    "selectedPair": {
      "additionalProperties": false,
      "properties": {
        "lock_path": { "const": "sources/m2_5/scope/exact_two_deck_scope_lock.v1.json" },
        "lock_sha256": { "$ref": "#/$defs/digest" },
        "deck_ids": {
          "items": { "enum": ["m2-5/token-triumph", "m2-5/grave-danger"] },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "deck_names": {
          "items": { "enum": ["Token Triumph", "Grave Danger"] },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["lock_path", "lock_sha256", "deck_ids", "deck_names"],
      "type": "object"
    },
    "deck": {
      "additionalProperties": false,
      "properties": {
        "deck_id": { "pattern": "^m2-5/[a-z0-9-]+$", "type": "string" },
        "deck_name": { "type": "string" },
        "player": { "enum": [1, 2], "type": "integer" }
      },
      "required": ["deck_id", "deck_name", "player"],
      "type": "object"
    },
    "unresolved": {
      "additionalProperties": false,
      "properties": {
        "obligation_id": { "type": "string" },
        "reason_code": { "type": "string" },
        "subject": { "type": "string" },
        "evidence_refs": { "items": { "type": "object" }, "type": "array" }
      },
      "required": ["obligation_id", "reason_code", "subject", "evidence_refs"],
      "type": "object"
    }
  },
  "title": "M2.5 Selected-Pair Capability Decision Information Census v1",
  "type": "object"
}
