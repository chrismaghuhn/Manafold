{
  "$id": "synthetic-m3-observation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_player": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "priority": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "held_by"
            },
            "player": {
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "player"
          ],
          "type": "object"
        }
      ]
    },
    "schema_version": {
      "const": "synthetic-m3-observation.v1"
    },
    "turn_number": {
      "pattern": "^(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "turn_position": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "beginning"
            },
            "step": {
              "enum": [
                "untap",
                "upkeep",
                "draw"
              ]
            }
          },
          "required": [
            "kind",
            "step"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "precombat_main"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "combat"
            },
            "step": {
              "enum": [
                "beginning_of_combat",
                "declare_attackers",
                "declare_blockers",
                "combat_damage",
                "end_of_combat"
              ]
            }
          },
          "required": [
            "kind",
            "step"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "postcombat_main"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "ending"
            },
            "step": {
              "enum": [
                "end_step",
                "cleanup"
              ]
            }
          },
          "required": [
            "kind",
            "step"
          ],
          "type": "object"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "active_player",
    "turn_number",
    "turn_position",
    "priority"
  ],
  "title": "SyntheticM3Observation v1",
  "type": "object"
}
