{
  "$id": "relation-application-authority.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manafold M2.5.C RelationApplication Authority V2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "manafold.m2.5.c.relation-application-authority.v2" },
    "base_authority_v1_binding": { "$ref": "#/$defs/source_binding" },
    "candidate_universe_binding": { "$ref": "#/$defs/source_binding" },
    "source_bindings": { "type": "array", "items": { "$ref": "#/$defs/source_binding" } },
    "relation_application_v2_records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "relation_application_v2_supersession_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/supersession_record" }
    }
  },
  "required": [
    "schema",
    "base_authority_v1_binding",
    "candidate_universe_binding",
    "source_bindings",
    "relation_application_v2_records",
    "relation_application_v2_supersession_records"
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*://)(?![A-Za-z]:)[^\\r\\n]+$"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_role": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relative_path" },
        "schema": { "type": ["string", "null"] },
        "raw_sha256": { "$ref": "#/$defs/digest" }
      },
      "required": ["artifact_role", "path", "schema", "raw_sha256"]
    },
    "identity": {
      "type": "string",
      "pattern": "^(rpa\\.v2|rpar\\.v2|rps\\.v2|rpsr\\.v2|rpr\\.v1)/[0-9a-f]{64}$"
    },
    "digest_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envelope_id": { "const": "mtgml.digest-envelope.v1" },
        "algorithm_id": { "const": "sha-256" },
        "semantic_domain": { "type": "string", "minLength": 1 },
        "payload_codec_id": { "const": "mtgml.canonical-cbor.v1" },
        "input_schema_id": { "type": "string", "minLength": 1 },
        "digest_hex": { "$ref": "#/$defs/digest" }
      },
      "required": ["envelope_id", "algorithm_id", "semantic_domain", "payload_codec_id", "input_schema_id", "digest_hex"]
    },
    "locator": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "whole_artifact" } }, "required": ["kind"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "json_pointer" }, "value": { "type": "string" } }, "required": ["kind", "value"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "archive_member" }, "value": { "$ref": "#/$defs/relative_path" } }, "required": ["kind", "value"] }
      ]
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_kind": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relative_path" },
        "locator": { "$ref": "#/$defs/locator" },
        "raw_sha256": { "$ref": "#/$defs/digest" }
      },
      "required": ["authority_kind", "path", "locator", "raw_sha256"]
    },
    "participant_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "role": { "type": "string", "minLength": 1 },
        "participant_kind": { "type": "string", "minLength": 1 },
        "semantic_ref": { "type": "string", "minLength": 1 }
      },
      "required": ["position", "role", "participant_kind", "semantic_ref"]
    },
    "relation_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "directionality": { "type": "string", "minLength": 1 },
        "host_relationship": { "type": "string", "minLength": 1 },
        "participant_bindings": { "type": "array", "items": { "$ref": "#/$defs/participant_binding" }, "minItems": 1 }
      },
      "required": ["scope", "relation", "directionality", "host_relationship", "participant_bindings"]
    },
    "role_bridge_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "position": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "participant_kind": { "type": "string", "minLength": 1 },
        "semantic_ref": { "type": "string", "minLength": 1 },
        "historical_source_role": { "type": "string", "minLength": 1 },
        "reviewed_role": { "type": "string", "minLength": 1 }
      },
      "required": ["position", "participant_kind", "semantic_ref", "historical_source_role", "reviewed_role"]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precondition_id": { "type": "string", "minLength": 1 },
        "observed_value": {},
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" }, "minItems": 1 },
        "equivalence_rationale": { "type": "string", "minLength": 1 }
      },
      "required": ["precondition_id", "observed_value", "evidence_refs", "equivalence_rationale"]
    },
    "member_proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "positive_interaction" },
            "causal_chain_ordinals": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "class_projection_equivalence": { "type": ["object", "null"] }
          },
          "required": ["kind", "causal_chain_ordinals", "class_projection_equivalence"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "positive_separation" },
            "channel_coverages": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false } }
          },
          "required": ["kind", "channel_coverages"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "model_bound_scope" },
            "scope_boundary_attestation": { "type": "object", "additionalProperties": false }
          },
          "required": ["kind", "scope_boundary_attestation"]
        }
      ]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "candidate_identity": { "$ref": "#/$defs/digest_reference" },
        "source_instance_id": { "type": "string", "minLength": 1 },
        "candidate_universe_binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "$ref": "#/$defs/relative_path" },
            "schema": { "type": "string", "minLength": 1 },
            "raw_sha256": { "$ref": "#/$defs/digest" }
          },
          "required": ["path", "schema", "raw_sha256"]
        },
        "relation_binding": { "$ref": "#/$defs/relation_binding" },
        "participant_role_bridge": { "type": "array", "items": { "$ref": "#/$defs/role_bridge_entry" }, "minItems": 1 },
        "precondition_attestations": { "type": "array", "items": { "$ref": "#/$defs/precondition" } },
        "member_evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" }, "minItems": 1 },
        "member_proof_attestation": { "$ref": "#/$defs/member_proof" }
      },
      "required": ["candidate_id", "candidate_identity", "source_instance_id", "candidate_universe_binding", "relation_binding", "participant_role_bridge", "precondition_attestations", "member_evidence_refs", "member_proof_attestation"]
    },
    "review_event_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string", "pattern": "^ae\\.v4/[0-9a-f]{64}$" },
        "path": { "$ref": "#/$defs/relative_path" },
        "raw_sha256": { "$ref": "#/$defs/digest" }
      },
      "required": ["event_id", "path", "raw_sha256"]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": { "type": "string", "pattern": "^rpar\\.v2/[0-9a-f]{64}$" },
        "application_id": { "$ref": "#/$defs/identity" },
        "theorem_record_id": { "type": "string", "pattern": "^rpr\\.v1/[0-9a-f]{64}$" },
        "terminal_disposition": { "enum": ["required_interaction", "not_an_interaction_with_proof", "out_of_declared_scope_with_reason"] },
        "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/member" } },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision": { "const": "human_accepted" },
            "review_event_ref": { "$ref": "#/$defs/review_event_ref" }
          },
          "required": ["decision", "review_event_ref"]
        }
      },
      "required": ["record_id", "application_id", "theorem_record_id", "terminal_disposition", "members", "acceptance"]
    },
    "supersession_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_id": { "type": "string", "pattern": "^rpsr\\.v2/[0-9a-f]{64}$" },
        "supersession_id": { "type": "string", "pattern": "^rps\\.v2/[0-9a-f]{64}$" },
        "superseded_record_id": { "type": "string", "pattern": "^rpar\\.v2/[0-9a-f]{64}$" },
        "replacement_record_id": { "type": ["string", "null"], "pattern": "^rpar\\.v2/[0-9a-f]{64}$" },
        "superseded_record_kind": { "const": "relation_application_v2_record" },
        "replacement_record_kind": { "enum": ["relation_application_v2_record", null] },
        "reason_code": { "enum": ["semantic_correction", "source_revision", "model_revision", "authority_revocation"] },
        "source_evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence_ref" } },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision": { "const": "human_accepted" },
            "review_event_ref": { "$ref": "#/$defs/review_event_ref" }
          },
          "required": ["decision", "review_event_ref"]
        }
      },
      "required": ["record_id", "supersession_id", "superseded_record_id", "replacement_record_id", "superseded_record_kind", "replacement_record_kind", "reason_code", "source_evidence_refs", "acceptance"]
    }
  }
}
